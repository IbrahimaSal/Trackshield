# PostgreSQL (utilisé par Prisma et converti automatiquement en JDBC pour Flyway)
DATABASE_URL=postgresql://trackshield:trackshield@localhost:5432/trackshield

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production-refresh
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# FastAPI Analyzer
ANALYZER_URL=http://localhost:8000
ANALYZER_HMAC_SECRET=change-me-in-production

# NestJS API
API_URL=http://localhost:3000
NODE_ENV=development
PORT=3000
