{
  "name": "trackshield",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:migrate": "./scripts/flyway-run.sh migrate",
    "db:info": "./scripts/flyway-run.sh info",
    "db:validate": "./scripts/flyway-run.sh validate",
    "db:rollback": "./scripts/flyway-run.sh undo",
    "db:repair": "./scripts/flyway-run.sh repair",
    "db:seed": "pnpm --filter api prisma db seed",
    "db:studio": "pnpm --filter api prisma studio",
    "db:generate": "pnpm --filter api prisma generate",
    "install:hooks": "./scripts/install-hooks.sh",
    "lists:compile": "pnpm --filter tracker-lists compile"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
